{
  "name": "dsh-client-ui-chart",
  "version": "0.1.0",
  "description": "Client plugin for dsh-data-agent: renders generate_chart results as inline ECharts in the chat (tool.call.toolview keyed seat)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/build-client.mjs --noemit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "clean": "rimraf lib"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "file:C:/Users/zhenjun/.dsh/profiles/node_modules/@deepseek-ai/dsh-client-runtime",
    "@deepseek-ai/dsh-client-ui-slots": "file:C:/Users/zhenjun/.dsh/profiles/node_modules/@deepseek-ai/dsh-client-ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "file:C:/Users/zhenjun/.dsh/profiles/node_modules/@deepseek-ai/dsh-client-ui-tool",
    "@types/react": "^18.3.0",
    "echarts": "^5.5.0",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
